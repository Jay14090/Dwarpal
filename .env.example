# Copy to .env (make setup does this). Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=dwarpal
POSTGRES_PASSWORD=dwarpal
POSTGRES_DB=dwarpal
POSTGRES_PORT=5432
# Overrides database.url in config/settings.yaml. Keep in sync with the values above.
DATABASE_URL=postgresql+psycopg://dwarpal:dwarpal@localhost:5432/dwarpal

# --- MediaMTX ports ---
RTSP_PORT=8554
HLS_PORT=8888
MEDIAMTX_API_PORT=9997

# --- Runtime ---
# auto | cuda | mps | cpu   (auto picks CUDA, then MPS, then CPU)
DWARPAL_DEVICE=auto
# Optional: point at another config directory
# DWARPAL_CONFIG_DIR=config

# --- Natural-language search (P7). Leave empty to use the rule-based parser. ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Dataset downloads (P1) ---
HF_TOKEN=

# --- Plate datasets (P5, optional) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
ROBOFLOW_API_KEY=
